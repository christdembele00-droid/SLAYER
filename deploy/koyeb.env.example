# SLAYER API runtime variables for Koyeb.
# Never commit real secrets.
PORT=8080
SLAYER_ENV=production
SLAYER_TICK_RATE=20

# External PostgreSQL — use a provider intended for persistent data.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Firebase Admin
# Preferred: JSON service-account object or a mounted file path.
FIREBASE_SERVICE_ACCOUNT=
# Alternative:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Browser/WebSocket origin allow-list.
SLAYER_ALLOWED_ORIGINS=https://YOUR-SLAYER-WEB-DOMAIN

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
