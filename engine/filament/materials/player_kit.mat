material {
    name : "SLAYER_PlayerKit",
    shadingModel : cloth,
    parameters : [
        { type : sampler2d, name : baseColorMap },
        { type : sampler2d, name : normalMap },
        { type : sampler2d, name : aoMap },
        { type : float, name : roughness },
        { type : float3, name : sheenColor },
        { type : float3, name : subsurfaceColor }
    ],
    requires : [ uv0, tangents ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        material.baseColor = texture(materialParams_baseColorMap, uv);
        material.normal = texture(materialParams_normalMap, uv).xyz * 2.0 - 1.0;
        material.ambientOcclusion = texture(materialParams_aoMap, uv).r;
        material.roughness = clamp(materialParams_roughness, 0.35, 0.95);
        material.sheenColor = materialParams_sheenColor;
        material.subsurfaceColor = materialParams_subsurfaceColor;
    }
}
