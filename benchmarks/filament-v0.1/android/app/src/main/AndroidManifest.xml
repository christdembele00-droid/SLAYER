<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.vulkan.version" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:theme="@style/AppTheme"
        android:label="SLAYER Filament Vulkan"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:icon="@drawable/ic_slayer"
        android:roundIcon="@drawable/ic_slayer">
        <meta-data
            android:name="com.google.test.loops"
            android:value="5" />
        <meta-data
            android:name="com.google.test.loops.player_experience"
            android:value="1" />
        <meta-data
            android:name="com.google.test.loops.gpu_compatibility"
            android:value="2" />
        <meta-data
            android:name="com.google.test.loops.performance"
            android:value="3" />
        <meta-data
            android:name="com.google.test.loops.compatibility"
            android:value="4" />
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.intent.action.TEST_LOOP" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/javascript" />
            </intent-filter>
        </activity>
    </application>
</manifest>