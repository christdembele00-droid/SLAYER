material {
    name : "SLAYER_StadiumGrass",
    shadingModel : lit,
    requires : [ uv0 ]
    parameters : [
        { type : sampler2d, name : normalMap },
        { type : sampler2d, name : aoMap },
        { type : float, name : roughness },
        { type : float, name : normalStrength },
        { type : float, name : wetness }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = fract(getUV0());
        float stripe = 0.5 + 0.5 * sin(uv.x * 113.097);
        float micro = 0.5 + 0.5 * sin(uv.x * 173.0 + uv.y * 127.0);
        float green = 0.12 + 0.055 * stripe + 0.018 * micro;

        float w = 0.007;
        float center = 1.0 - smoothstep(0.0, w, abs(uv.x - 0.5));
        float touch = max(1.0 - smoothstep(0.0, w, abs(uv.x - 0.02)),
                           1.0 - smoothstep(0.0, w, abs(uv.x - 0.98)));
        float ends = max(1.0 - smoothstep(0.0, w, abs(uv.y - 0.02)),
                         1.0 - smoothstep(0.0, w, abs(uv.y - 0.98)));

        float boxLeft = step(0.12, uv.x) * step(uv.x, 0.30);
        float boxRight = step(0.70, uv.x) * step(uv.x, 0.88);
        float boxLines = max(
            (1.0 - smoothstep(0.0, w, abs(uv.y - 0.25))) * boxLeft,
            (1.0 - smoothstep(0.0, w, abs(uv.y - 0.75))) * boxRight);

        float markings = clamp(max(max(center, touch), max(ends, boxLines)), 0.0, 1.0);
        vec3 grass = vec3(green * 0.34, green, green * 0.30);
        material.baseColor = vec4(mix(grass, vec3(0.88, 0.88, 0.82), markings), 1.0);

        // Runtime maps can replace the procedural fallback. The normal map
        // adds grass micro-relief; AO darkens contact areas; wetness lowers
        // roughness so floodlights produce restrained wet-field highlights.
        vec3 n = texture(materialParams_normalMap, uv * 8.0).xyz * 2.0 - 1.0;
        n.xy *= materialParams_normalStrength;
        material.normal = normalize(vec3(n.xy, max(0.25, n.z)));

        float ao = texture(materialParams_aoMap, uv * 8.0).r;
        material.ambientOcclusion = mix(0.72, 1.0, ao);

        float baseRoughness = mix(0.84, 0.58, markings);
        material.roughness = clamp(mix(baseRoughness, 0.38, materialParams_wetness), 0.25, 0.9);
        material.metallic = 0.0;
    }
}
