# API / process
PORT=8080
SLAYER_ENV=development
SLAYER_TICK_RATE=20

# Database
DATABASE_URL=postgresql+psycopg://user:password@host:5432/slayer

# Firebase Admin
# Preferred: complete JSON service-account object, or a path to the JSON file.
FIREBASE_SERVICE_ACCOUNT=
# Alternative fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Production CORS / WebSocket Origin allow-list
SLAYER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
