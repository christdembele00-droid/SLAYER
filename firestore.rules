rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/slayerRooms/$(roomId))
        && (
          get(/databases/$(database)/documents/slayerRooms/$(roomId)).data.created_by == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/slayerRooms/$(roomId)).data.member_uids
        );
    }

    match /slayerProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
      allow delete: if false;
    }

    match /slayerRooms/{roomId} {
      allow read: if roomMember(roomId);
      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.member_uids is list
        && request.auth.uid in request.resource.data.member_uids
        && request.resource.data.member_uids.size() <= 22;
      allow update: if signedIn()
        && resource.data.created_by == request.auth.uid
        && request.resource.data.created_by == resource.data.created_by
        && request.resource.data.member_uids is list
        && request.resource.data.member_uids.size() <= 22;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if roomMember(roomId);
        allow create: if roomMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300
          && request.resource.data.type in ['chat', 'quick'];
        allow update, delete: if false;
      }
    }

    match /asset_catalog/{assetId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
